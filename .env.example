# Sanity CMS Configuration
# Get these from https://www.sanity.io/manage

# Your Sanity project ID (found in project settings)
VITE_SANITY_PROJECT_ID=your-project-id

# Dataset name (usually "production" or "development")
VITE_SANITY_DATASET=production

# Optional: API token for authenticated requests (only if using private datasets)
# Create at https://www.sanity.io/manage → API → Tokens
# VITE_SANITY_API_TOKEN=your-token

# Note: For public datasets, no token is needed.
# The template works without Sanity - it falls back to default content.
